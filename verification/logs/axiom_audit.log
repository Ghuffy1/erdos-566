def Erdos566.OriginalStatement : Prop :=
∀ (p : ℕ) (G : SimpleGraph (Fin p)),
  (∀ (S : Finset (Fin p)), 2 ≤ S.card → (SimpleGraph.induce (↑S) G).edgeSet.ncard ≤ 2 * S.card - 3) →
    Erdos566.IsRamseySizeLinear G
def PrizeStatement.Statement : Prop :=
∀ (p : ℕ) (G : SimpleGraph (Fin p)),
  (∀ (S : Finset (Fin p)), 2 ≤ S.card → (SimpleGraph.induce (↑S) G).edgeSet.ncard ≤ 2 * S.card - 3) →
    PrizeStatement.IsRamseySizeLinear G
def Verification.originalProblem : Prop :=
∀ (p : ℕ) (G : SimpleGraph (Fin p)),
  (∀ (S : Finset (Fin p)), 2 ≤ S.card → (SimpleGraph.induce (↑S) G).edgeSet.ncard ≤ 2 * S.card - 3) →
    Verification.ramseySizeLinear G
theorem Erdos566.original_statement_false : ¬Erdos566.OriginalStatement :=
Erdos566.not_original_of_sampled_cube Erdos566.Spectrum.sampled_cube_statement
theorem PrizeStatement.original_problem_false : ¬PrizeStatement.Statement :=
Erdos566.original_statement_false
theorem Verification.original_problem_false : ¬Verification.originalProblem :=
Erdos566.original_statement_false
